{
  "compilerOptions": {
    "checkJs": true,
    "target": "es2022",
    "module": "es2022",
    "moduleResolution": "bundler",
    "allowJs": true,
    "strict": false,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "lib": ["es2022", "dom", "dom.iterable"]
  },
  "include": ["static/js/**/*.js"],
  "exclude": ["node_modules", "target"]
}
